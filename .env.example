# Environment Variables for FactLearning
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/factlearning?sslmode=require"

# Auth.js
AUTH_SECRET="your-random-secret-here-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
